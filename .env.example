# ==============================================================================
# GPS Spindle ERP — Supabase Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to .env or .env.local and populate with your actual project keys.
# NEVER commit your real .env file with secrets to Git.
# ==============================================================================

# Supabase Project URL (e.g., https://your-project-ref.supabase.co)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anonymous/Public API Key (safe for browser client)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key-here

# Optional: Application Environment (development | staging | production)
VITE_APP_ENV=development
